<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream) — Twitter-inspired minimal look.
     Wallpaper at full brightness (no scrim). Clock, sun times, and rotating quote drift
     for burn-in protection. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Wallpaper — no dark overlay; the image is the hero. -->
    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Overlay kept at transparent; never given a scrim with this design. -->
    <View
        android:id="@+id/dreamOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:importantForAccessibility="no" />

    <!-- Ambient rainbow glow — subtle radial behind the drifting block. -->
    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Drifting clock block — center-aligned column. -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Abbreviated date: MON, 26 OCT -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textColor="#70FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true" />

        <!-- Large clock — no AM/PM; 24 h on this TV (HH:mm), 12 h shows h:mm -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="140sp"
            android:fontFamily="@font/inter_light"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false"
            android:layout_marginTop="-6dp" />

        <!-- Sunrise / sunset times — set in code from astronomical calculation. -->
        <TextView
            android:id="@+id/dreamSunTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#65FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/inter_regular"
            android:letterSpacing="0.05" />

        <!-- Thin separator between meta info and the quote. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:background="#20FFFFFF" />

        <!-- Rotating tech quote — italic, changes each drift. -->
        <TextView
            android:id="@+id/dreamQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_regular"
            android:textStyle="italic"
            android:letterSpacing="0.04"
            android:maxWidth="420dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
