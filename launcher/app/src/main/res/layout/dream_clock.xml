<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream) — full-brightness wallpaper, rotating from walls/ folder.
     All small text is near-pure white with a hairline shadow so it reads on any wallpaper. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Always transparent — no scrim. -->
    <View
        android:id="@+id/dreamOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:importantForAccessibility="no" />

    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Abbreviated date: TUE, 27 OCT — bright + hairline shadow -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:textColor="#F0FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.22"
            android:textAllCaps="true"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1" />

        <!-- Large clock: h:mm (12h) or HH:mm (24h) — pure white -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="140sp"
            android:fontFamily="@font/inter_light"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false"
            android:layout_marginTop="-6dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="4"
            android:shadowDx="0"
            android:shadowDy="2" />

        <!-- Sunrise / sunset — bright, medium weight -->
        <TextView
            android:id="@+id/dreamSunTimes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#E8FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.05"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1" />

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:background="#50FFFFFF" />

        <!-- Rotating tech quote — bright italic -->
        <TextView
            android:id="@+id/dreamQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F0FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_medium"
            android:textStyle="italic"
            android:letterSpacing="0.04"
            android:maxWidth="420dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
