<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver (ClockDream) — all upgrades active:
     A: center-align + AM/PM superscript
     B: thin separator + rotating quote
     C: rainbow glow
     D: staggered child fade-in
     E: 15% scrim + Ken Burns wallpaper pan
     F: split date (day name / day + month on separate lines) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- E: Wallpaper — Ken Burns zoom/pan started in code after bitmap loads. -->
    <ImageView
        android:id="@+id/dreamWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- E: Very light 15% scrim — set to 0x26000000 in code when wallpaper is loaded. -->
    <View
        android:id="@+id/dreamOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#00000000"
        android:importantForAccessibility="no" />

    <!-- C: Ambient rainbow glow drawn as radial gradient in code. -->
    <View
        android:id="@+id/dreamAmbient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- A: Clock block — centered horizontally; children fade in staggered (D). -->
    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- A: Time row — gravity=top so AM/PM acts as a superscript. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="#E6FFFFFF"
                android:textSize="120sp"
                android:fontFamily="@font/inter_light"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <!-- A: small superscript — sits top-right of digits with a top margin nudge. -->
            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:format12Hour="a"
                android:format24Hour=""
                android:textColor="#80FFFFFF"
                android:textSize="20sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.10"
                android:textAllCaps="true" />
        </LinearLayout>

        <!-- F: Day name — small, wide-tracked, muted. -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:format12Hour="EEEE"
            android:format24Hour="EEEE"
            android:textColor="#55FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.28"
            android:textAllCaps="true" />

        <!-- F: Day number + Month — larger, thin. -->
        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:format12Hour="d MMMM"
            android:format24Hour="d MMMM"
            android:textColor="#99FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/inter_light"
            android:letterSpacing="0.10"
            android:textAllCaps="true" />

        <!-- B: Thin separator between date and quote. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:background="#28FFFFFF" />

        <!-- B: Rotating tech quote — italic, faded, changes each drift cycle. -->
        <TextView
            android:id="@+id/dreamQuote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter_regular"
            android:textStyle="italic"
            android:letterSpacing="0.04"
            android:maxWidth="420dp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
