<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: solid bright glass with strong specular sheen + crisp rim -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FDFFFFFF" android:endColor="#EEFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <!-- specular: bright top 40% fade -->
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#88FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#BBFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Unfocused: stronger glass body + brighter rim (matches tile border upgrade) -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#55FFFFFF" android:endColor="#1AFFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <!-- specular: subtle top sheen -->
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#55FFFFFF" />
                    <corners android:radius="21dp" />
                </shape>
            </item>
        </layer-list>
    </item>

</selector>
